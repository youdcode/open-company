{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": {
      "*": "ask",
      "workspace/*": "allow",
      "workspace/**": "allow"
    },
    "bash": {
      "*": "ask",
      "node tools/*": "allow",
      "node viewer/*": "allow",
      "git push *": "deny",
      "rm *": "deny"
    },
    "webfetch": "allow",
    "websearch": "allow"
  }
}
